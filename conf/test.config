/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run biowei/tbwgs -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 2,
        memory: '7.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data: reads simulated from H37Rv, see https://github.com/biowei/tbwgs-test-datasets
    input         = params.pipelines_testdata_base_path + 'samplesheet/samplesheet_test.csv'

    // Reference and mask from tbdb at commit c4167762
    mtb_reference = 'https://raw.githubusercontent.com/jodyphelan/tbdb/c4167762ed361c679507e3f4ebe0cd277eae6102/genome.fasta'
    mtb_mask_bed  = 'https://raw.githubusercontent.com/jodyphelan/tbdb/c4167762ed361c679507e3f4ebe0cd277eae6102/mask.bed'

    // SARS-CoV-2 Kraken2 database: small enough for CI. It has no MTBC taxon, so the MTBC fraction is 0
    kraken2db     = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome/db/kraken2.tar.gz'
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'CAT_FASTQ|UNTAR_.*|SAMTOOLS_FAIDX|BWA_INDEX' {
        publishDir = [ enabled: false ]
    }

    // The module asks for 7 bytes per base (31 MB for H37Rv), and the docker test runs were killed at that limit.
    withName: BWA_INDEX {
        memory = { 1.GB * task.attempt }
    }

    // Read group so that later VCFs carry the sample name
    withName: BWA_MEM {
        ext.args   = { "-R '@RG\\tID:${meta.id}\\tSM:${meta.id}\\tPL:ILLUMINA'" }
        publishDir = [ enabled: false ]
    }

    withName: SAMTOOLS_SORMADUP {
        ext.prefix = { "${meta.id}.markdup" }
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.{bam,metrics}'
        ]
    }

    withName: SAMTOOLS_INDEX {
        publishDir = [
            path: { "${params.outdir}/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.bai'
        ]
    }

    // No per-base output; the quantized BED marks sites below mtb_min_site_depth as LOW
    withName: MOSDEPTH {
        ext.args   = { "--no-per-base --quantize 0:${params.mtb_min_site_depth}:" }
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: params.publish_dir_mode,
            pattern: '*.{txt,bed.gz,bed.gz.csi}'
        ]
    }

    withName: SAMTOOLS_STATS {
        publishDir = [
            path: { "${params.outdir}/coverage" },
            mode: params.publish_dir_mode,
            pattern: '*.stats'
        ]
    }

    // Haploid calls; base and mapping quality cut-offs are fixed until validation says otherwise
    withName: BCFTOOLS_MPILEUP {
        ext.args   = '--min-BQ 20 --min-MQ 20 --max-depth 1000 --annotate FORMAT/AD,FORMAT/DP'
        ext.args2  = '--ploidy 1 --multiallelic-caller --variants-only'
        ext.args3  = '--output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.raw" }
        publishDir = [ enabled: false ]
    }

    withName: BCFTOOLS_NORM {
        ext.args   = '--multiallelics -any --output-type z --write-index=tbi'
        ext.prefix = { "${meta.id}.norm" }
        publishDir = [ enabled: false ]
    }

    withName: BCFTOOLS_FILTER {
        ext.args   = { "--include 'QUAL>=20 && INFO/DP>=${params.mtb_min_site_depth}' --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            pattern: '*.{vcf.gz,vcf.gz.tbi}'
        ]
    }

    withName: BCFTOOLS_STATS {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: params.publish_dir_mode,
            pattern: '*stats.txt'
        ]
    }

    withName: MERGE_MASK_BED {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            pattern: '*.mask.bed'
        ]
    }

    // SNPs only, so every consensus keeps the H37Rv length and the sequences line up for clustering
    withName: BCFTOOLS_CONSENSUS {
        ext.args   = "--include 'TYPE=\"snp\"'"
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            pattern: '*.fa'
        ]
    }

    withName: FASTP {
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,html,log}'
        ]
    }

    withName: KRAKEN2_KRAKEN2 {
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode,
            pattern: '*report.txt'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
